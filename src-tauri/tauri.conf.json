{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lurk",
  "version": "0.1.0",
  "identifier": "com.novaadev.lurk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "lurk",
        "width": 1000,
        "height": 700,
        "visible": false,
        "decorations": false
      },
      {
        "label": "widget",
        "dragDropEnabled": false,
        "title": "Lurk Widget",
        "url": "index.html",
        "width": 360,
        "height": 480,
        "minWidth": 280,
        "minHeight": 220,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visible": false
      },
      {
        "label": "splash",
        "title": "Lurk",
        "url": "index.html",
        "width": 440,
        "height": 300,
        "center": true,
        "decorations": false,
        "resizable": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {"installMode": "currentUser"}
    }
  }
}
